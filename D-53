/*Write a Program to take an array of integers as input,
 calculate the pivot index of this array. The pivot index is the index where the sum of
  all the numbers strictly to the left of the index is equal to the sum of all the numbers 
  strictly to the index's right. If the index is on the left edge of the array, then the left 
  sum is 0 because there are no elements to the left. This also applies to the right edge of the 
  array. Print the leftmost pivot index. If no such index exists, print -1.*/

  #include <stdio.h>
  int main()
  {
    int n,suml=0,sumr=0,p=-1;
    printf("Enter the number of elements in the array: ");
    scanf("%d",&n);
    int ar[n];
    printf("Enter the elements of array: ");
    for(int i=0;i<n;i++)
    scanf("%d",&ar[i]);
    for(int i=0;i<n;i++)
    {
        suml = 0;
        sumr = 0;
        for(int j=i+1;j<n;j++)
        sumr+=ar[j];
        for(int k=0;k<i;k++)
        suml+=ar[k];
        if(suml==sumr)
        {
            p=i;
            break;
        }
    }
    printf("Pivot index: %d",p);
    return 0;
  }
