Q. Write a program to find the HCF (GCD) of two numbers.
#include <stdio.h>
int main()
{
    int n1,n2,hcf=1;
    printf("Enter two numbers: ");
    scanf("%d %d",&n1,&n2);
    for(int i=1;i<=n1;i++)
    {
        for(int j=1;j<=n2;j++)
        {
            if(n1%i==0 && n2%j==0 && i==j)
            {
               hcf=i;
            }
        }
    }
    printf("HCF of %d and %d is %d",n1,n2,hcf);
    return 0;
}
