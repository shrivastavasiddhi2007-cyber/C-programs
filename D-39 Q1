Q. Check if the elements on the diagonal of a matrix are distinct.

#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    int matrix[100][100];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    int distinct = 1;

    for (int i = 0; i < n && distinct; i++) {
        for (int j = i + 1; j < n && distinct; j++) {
            if (matrix[i][i] == matrix[j][j]) {
                distinct = 0;
            }
        }
    }

    if (distinct) {
        printf("Yes\n");
    } else {
        printf("No\n");
    }

    return 0;
}
