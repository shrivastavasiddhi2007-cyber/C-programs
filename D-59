/*Write a Program to take an integer array nums. Print an array answer such that answer[i] 
is equal to the product of all the elements of nums except nums[i].*/

#include <stdio.h>
int main()
{
    int n,p=1;
    printf("Enter the length of the array: ");
    scanf("%d",&n);
    int ar[n];
    printf("Enter the array inputs: ");
    for(int i=0;i<n;i++)
    scanf("%d",&ar[i]);
    printf("New array:\n");
    for(int i=0;i<n;i++)
    {
        p=1;
        for(int j=0;j<n;j++)
        {
            if(i!=j)
            p*=ar[j];
        }
        printf("%d ",p);
    }
    return 0;
}
