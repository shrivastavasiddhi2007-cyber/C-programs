Q. Change the date format from dd/04/yyyy to dd-Apr-yyyy.

#include <stdio.h>
#include <string.h>
int main()
{
    char date[100];
    int c=0,i;
    printf("Enter the date in dd/04/yyyy format: ");
    scanf("%s",date);
    int k=strlen(date);
    date[k+1]='\0';
    for( i=0;date[i]!='\0';i++)
    {
        if(date[i]=='/' && c==0)
        {
            while(date[k]!='/')
            {
                date[k]=date[k-1];
                k--;
            }
            date[i]='-';
            date[i+1]='A';
            date[i+2]='p';
            date[i+3]='r';
            date[i+4]='-';
            c=1;
        }
    }
    printf("Date: %s",date);
    return 0;
}
