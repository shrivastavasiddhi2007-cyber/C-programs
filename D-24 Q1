Q. Write a program to print the following pattern:
      *
      **
      ***
      ****
      *****
#include <stdio.h>
int main()
{
    int k;
    for(int i=0;i<5;i++)
    {
        k=1;
        for(int j=0;j<5;j++)
        {
            if(i>=j)
            {
                printf(" %d ", k);
                k++;
            }
        }
        printf("\n");
    }
    return 0;
}
