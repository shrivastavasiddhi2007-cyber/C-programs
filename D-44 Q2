Q. Replace spaces with hyphens in a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    printf("Enter the string\n");
    fgets(s,100,stdin);
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]==' ')
        s[i]='_';
    }
    printf("The String: %s",s);
    return 0;
}
