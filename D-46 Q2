Q. Find the first repeating lowercase alphabet in a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100],ch;
    printf("Enter a string: ");
    scanf("%s",s);
    for(int i=0;s[i]!='\0';i++)
    {
        for(int j=i;s[j]!='\0';j++)
        {
            if(s[j]==s[i] && s[j]>=97 &&s[j]<=120)
            ch=s[j];
        }
    }
    printf("The first repeating lowercase alphabet in the string: %c",ch);
    return 0;
}
