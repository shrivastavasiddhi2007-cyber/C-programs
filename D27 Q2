Q. Write a program to print the following pattern:

   *
  ***
 *****
*******
 *****
  ***
   *

#include <stdio.h>
int main()
{
   for(int i=8; i>1; i--)
    {
        if(i%2==0)
        continue;
        for(int j=1; j<=7; j++)
        {
            if(j>=i )
            {
                printf("* ");
            }
            else
            {
                printf(" ");
            }
        }
        printf("\n");
    }
     for(int i=8; i>=1; i--)
    {
        if(i%2==0)
        continue;
        for(int j=1; j<=7; j++)
        {
            if(j>=8-i )
            {
                printf("* ");
            }
            else
            {
                printf(" ");
            }
        }
        printf("\n");
    }
    return 0;
}
