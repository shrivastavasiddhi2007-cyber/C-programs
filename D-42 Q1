//Count vowels and consonants in a string.
#include <stdio.h>
#include <string.h>
int main()
{
    char s[100],ch;
    int vcount=0,ccount=0;
    printf("Enter the string\n");
    scanf("%s",s);
    for(int i=0;s[i]!='\0';i++)
    {
        ch=s[i];
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U')
        vcount++;
        else
        ccount++;
    }
    printf("Vowel Count: %d ",vcount);
    printf("\nConsonant count: %d",ccount);
    return 0;
}
