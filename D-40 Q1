Q.Perform diagonal traversal of a matrix.

int main()
{
    int m;
    printf("Enter the order of matrix: ");
    scanf("%d",&m);
    int arr[m][m];
    printf("Enter elements of the array: ");
    for(int i=0;i<m;i++)
    {
        for(int j = 0; j < m; j++)
        scanf("%d", &arr[i][j]);
    }
    printf("The Original Matrix: \n");
    for(int i=0;i<m;i++)
    {
        for(int j = 0; j < m; j++)
        printf("%d ",arr[i][j]);
        printf("\n");
    }
    printf("The diagonal traversal of the matrix: \n");
    for (int d = 0; d < 2*m - 1; d++)
    {
        for (int i = 0; i < m; i++)
        {
            int j = d - i;
            if (j >= 0 && j < m)
            printf("%d ", arr[i][j]);
        }
        printf("\n");
    }
    return 0;
}
