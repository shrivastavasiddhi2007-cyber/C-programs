Q. Find the transpose of a matrix.

#include <stdio.h>
int main()
{
    int m,n;
    printf("Enter the number of rows & columns in the array: ");
    scanf("%d %d",&m ,&n);
    int arr[m][n];
    int sum[m];
    printf("Enter elements of the array: ");
    for(int i=0;i<m;i++)
    {
        for(int j = 0; j < n; j++)
        scanf("%d", &arr[i][j]);
    }
    printf("The Original Matrix: \n");
    for(int i=0;i<m;i++)
    {
        for(int j = 0; j < n; j++)
        printf("%d ",arr[i][j]);
        printf("\n");
    }
    printf("The Transposed Matrix: \n");
    for(int i=0;i<n;i++)
    {
        for(int j = 0; j < m; j++)
        printf("%d ",arr[j][i]);
        printf("\n");
    }
    return 0;
}
