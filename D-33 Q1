Q. Search in a sorted array using binary search.

#include <stdio.h>
int main()
{
    int n, key, low, high, mid;
    printf("Enter the number of elements in the array: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter elements of the sorted array: ");
    for(int i=0; i<n; i++)
        scanf("%d", &arr[i]);
    printf("Enter the element to search for: ");
    scanf("%d", &key);
    low = 0;
    high = n - 1;
    while(low <= high) {
        mid = (low + high) / 2;
        if(arr[mid] == key) {
            printf("Element found at index %d\n", mid);
            return 0;
        } else if(arr[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    printf("Element not found in the array.\n");
    return 0;
}
