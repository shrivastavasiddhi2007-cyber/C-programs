Q. Use enum to represent menu choices (ADD, SUBTRACT, MULTIPLY) and perform operations using switch.

#include <stdio.h>

enum Menu {
    ADD = 1, SUBTRACT, MULTIPLY
};

int main() {
    enum Menu choice;
    int a, b, ch;

    printf("1. ADD\n");
    printf("2. SUBTRACT\n");
    printf("3. MULTIPLY\n");

    printf("Enter your choice: ");
    scanf("%d", &ch);

    choice = (enum Menu)ch;

    printf("Enter two numbers: ");
    scanf("%d %d", &a, &b);

    switch (choice) {
        case ADD:
            printf("Sum = %d", a + b);
            break;

        case SUBTRACT:
            printf("Difference = %d", a - b);
            break;

        case MULTIPLY:
            printf("Product = %d", a * b);
            break;

        default:
            printf("Invalid Choice");
    }

    return 0;
}