Q.Reverse a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100],temp;
    printf("Enter a word: ");
    scanf("%s",s);
    int i=0;
    int j=strlen(s)-1;
    while(i<j)
    {
        temp=s[i];
        s[i]=s[j];
        s[j]=temp;
        i++;
        j--;
    }
    printf("Reversed: %s\n",s);
    return 0;
}
