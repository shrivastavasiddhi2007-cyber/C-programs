Q. Write a program to print the following pattern:
*
***
*****
*******
*********
*******
*****
***
*

#include <stdio.h>
int main()
{
    for(int i=11;i>=1;i--)
    {
        printf("\n");
        for(int j=11;j>=1;j--)
        {
            if(i>=j || i%2!=0)
            {
                continue;
            }
            else if(i>=j || i%2==0)
            {
                printf("*");
            }
        }
    }
    for(int i=1;i<=9;i++)
    {
        for(int j=1;j<=9;j++)
        {
            if(j<=i || i%2!=0)
            {
                continue;
            }
            else if(j<=i || i%2==0)
            {
                printf("*");
            }
        }
        printf("\n");
    }
    return 0;
}
