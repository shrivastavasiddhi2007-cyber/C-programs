//Convert a lowercase string to uppercase without using built-in functions.
#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    printf("Enter the string\n");
    scanf("%s",s);
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]>=97 && s[i]<=120)
        s[i]=s[i]-32;
        else
        continue;
    }
    printf("Word after converting cases: %s",s);
    return 0;
}
