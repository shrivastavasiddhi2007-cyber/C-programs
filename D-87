Q. Create an enum for user roles (ADMIN, USER, GUEST) and display messages based on role.

#include <stdio.h>

enum Role {
    ADMIN = 1, USER, GUEST
};

int main() {
    enum Role role;
    int choice;

    printf("1. ADMIN\n");
    printf("2. USER\n");
    printf("3. GUEST\n");

    printf("Enter your role: ");
    scanf("%d", &choice);

    role = (enum Role)choice;

    switch (role) {
        case ADMIN:
            printf("Welcome Admin! Full access granted.");
            break;

        case USER:
            printf("Welcome User! Limited access granted.");
            break;

        case GUEST:
            printf("Welcome Guest! View-only access granted.");
            break;

        default:
            printf("Invalid Role");
    }

    return 0;
}