Q.Print all sub-strings of a string.

#include <stdio.h>
#include <string.h>
int main()
{
    char s[100];
    printf("Enter the string: ");
    scanf("%s",s);
    int n=strlen(s);
    printf("The Substrings: ");
    for (int i = 0; i < n; i++) 
    {
        for (int j = i; j < n; j++) 
        {
            for (int k = i; k <= j; k++)
                printf("%c", s[k]);
            printf(" ");
        }
    }
    return 0;
}
