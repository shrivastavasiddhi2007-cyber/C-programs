Q. Find the sum of each row of a matrix and store it in an array.

#include <stdio.h>
int main()
{
    int m,n;
    printf("Enter the number of rows & columns in the array: ");
    scanf("%d %d",&m ,&n);
    int arr[m][n];
    int sum[m];
    printf("Enter elements of the array: ");
    for(int i=0;i<m;i++)
    {
        for(int j = 0; j < n; j++)
        scanf("%d", &arr[i][j]);
    }
    printf("The Matrix:\n");
    for(int i=0;i<m;i++)
    {
        for(int j = 0; j < n; j++)
        printf("%d ",arr[i][j]);
        printf("\n");
    }
    for(int i=0;i<m;i++)
    {
        sum[i]=0;
        for(int j = 0; j < n; j++)
        sum[i]=sum[i]+arr[i][j];
    }
    printf("Sum of Rows:");
    for(int k=0;k<m;k++)
    printf("%d ",sum[k]);
    return 0;
}
