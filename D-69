Q. Write a program to take an integer array as input. Only one element will be repeated. Print the repeated element. Try to find the result in one single iteration.

#include <stdio.h>

int main() {
    int n, i, num;
    int count[100001] = {0};

    scanf("%d", &n);

    for(i = 0; i < n; i++) {
        scanf("%d", &num);

        if(count[num] == 1) {
            printf("%d", num);
            return 0;
        }

        count[num] = 1;
    }

    return 0;
}