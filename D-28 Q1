Q. Write a program to print all the prime numbers from 1 to n.
#include <stdio.h>
int main()
{
    int n,count=0;
    printf("Enter the end range: ");
    scanf("%d",&n);
    printf("The prime numbers between 1 and %d are: \n",n);
    for(int i=1;i<=n;i++)
    {
        for(int j=1;j<=i;j++)
        {
            if(i%j==0)
            count++;
        }
        if(count==2)
        printf("%d ",i);
        count=0;
    }
    return 0;
}
