#include <stdio.h>
int main()
{
    int n;
    char grade;
    printf("Enter the marks: ");
    scanf("%d",&n);
    if(n>=90)
    grade='A';
    else if(n>=80)
    grade='B';
    else if(n>=70)
    grade='C';
    else if(n>=60)
    grade='D';
    else
    grade='F';
    printf("The grade is: %c",grade);
    return 0;
}
