Q.Write a program to print the following pattern:
5
45
345
2345
12345
#include <stdio.h>
int main()
{
    int i, j, d;
    for (i = 0; i < 5; i++)
    {
        d = 5 - i; 
        for (j = 0; j <= i; j++)
        {
            printf("%d", d);
            d++;
        }
        printf("\n");
    }
    return 0;
}
