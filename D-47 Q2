Q. Find the longest word in a sentence.

#include <stdio.h>
#include <string.h>
void main()
{
    char s[100],ch[100],lon[100]="";
    int j=0,len,lonlen=0;
    printf("Enter a sentence: ");
    fgets(s,100,stdin);
    len=strlen(s);
    s[len]=' ';
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]!=' ')
        {
            ch[j]=s[i];
            j++;
        }
        else
        {
            ch[j]='\0';
            len=strlen(ch);
            if(lonlen<len)
            {
                lonlen=len;
                for(int k=0;k<lonlen;k++)
                lon[k]=ch[k];
            }
            j=0;
        }
    }
    printf("Longest word in the sentence: %s",lon);
}
